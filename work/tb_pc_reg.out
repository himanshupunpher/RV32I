#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x59ebe3fc3600 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x59ebe3fc3790 .scope module, "tb_pc_reg" "tb_pc_reg" 3 9;
 .timescale -9 -12;
v0x59ebe3feeea0_0 .net "PC", 31 0, v0x59ebe3fbe0d0_0;  1 drivers
v0x59ebe3feef80_0 .var/i "checks", 31 0;
v0x59ebe3fef040_0 .var "clk", 0 0;
v0x59ebe3fef0e0_0 .var/i "errors", 31 0;
v0x59ebe3fef180_0 .var "next_pc", 31 0;
v0x59ebe3fef290_0 .var "reset", 0 0;
E_0x59ebe3fa5640 .event posedge, v0x59ebe3fbef70_0;
E_0x59ebe3f91f20 .event negedge, v0x59ebe3fbef70_0;
S_0x59ebe3fcba90 .scope task, "check" "check" 3 27, 3 27 0, S_0x59ebe3fc3790;
 .timescale -9 -12;
v0x59ebe3fbc200_0 .var "exp", 31 0;
v0x59ebe3fbd370_0 .var/str "name";
TD_tb_pc_reg.check ;
    %load/vec4 v0x59ebe3feef80_0;
    %addi 1, 0, 32;
    %store/vec4 v0x59ebe3feef80_0, 0, 32;
    %load/vec4 v0x59ebe3feeea0_0;
    %load/vec4 v0x59ebe3fbc200_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %load/vec4 v0x59ebe3fef0e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x59ebe3fef0e0_0, 0, 32;
    %vpi_call/w 3 32 "$display", "FAIL [%0d] %0s: PC=%h (expected %h) at time %0t", v0x59ebe3feef80_0, v0x59ebe3fbd370_0, v0x59ebe3feeea0_0, v0x59ebe3fbc200_0, $time {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 35 "$display", "PASS [%0d] %0s: PC=%h at time %0t", v0x59ebe3feef80_0, v0x59ebe3fbd370_0, v0x59ebe3feeea0_0, $time {0 0 0};
T_0.1 ;
    %end;
S_0x59ebe3feea00 .scope module, "dut" "pc_reg" 3 18, 4 1 0, S_0x59ebe3fc3790;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 32 "next_pc";
    .port_info 3 /OUTPUT 32 "PC";
v0x59ebe3fbe0d0_0 .var "PC", 31 0;
v0x59ebe3fbef70_0 .net "clk", 0 0, v0x59ebe3fef040_0;  1 drivers
v0x59ebe3feeca0_0 .net "next_pc", 31 0, v0x59ebe3fef180_0;  1 drivers
v0x59ebe3feed60_0 .net "reset", 0 0, v0x59ebe3fef290_0;  1 drivers
E_0x59ebe3f91b20 .event posedge, v0x59ebe3feed60_0, v0x59ebe3fbef70_0;
    .scope S_0x59ebe3feea00;
T_1 ;
    %wait E_0x59ebe3f91b20;
    %load/vec4 v0x59ebe3feed60_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x59ebe3fbe0d0_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x59ebe3feeca0_0;
    %assign/vec4 v0x59ebe3fbe0d0_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_0x59ebe3fc3790;
T_2 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59ebe3fef0e0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59ebe3feef80_0, 0, 32;
    %end;
    .thread T_2, $init;
    .scope S_0x59ebe3fc3790;
T_3 ;
    %delay 5000, 0;
    %load/vec4 v0x59ebe3fef040_0;
    %inv;
    %store/vec4 v0x59ebe3fef040_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x59ebe3fc3790;
T_4 ;
    %vpi_call/w 3 41 "$display", "=== tb_pc_reg: starting ===" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59ebe3fef040_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59ebe3fef290_0, 0, 1;
    %pushi/vec4 3735928559, 0, 32;
    %store/vec4 v0x59ebe3fef180_0, 0, 32;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59ebe3fef290_0, 0, 1;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "async reset forces PC=0 immediately (no clk edge needed)";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %wait E_0x59ebe3fa5640;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "PC stays 0 while reset held, even across posedge clk";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59ebe3fef290_0, 0, 1;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "PC stays 0 immediately after reset deasserted (no clk edge yet)";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %pushi/vec4 4096, 0, 32;
    %store/vec4 v0x59ebe3fef180_0, 0, 32;
    %wait E_0x59ebe3fa5640;
    %delay 1000, 0;
    %pushi/vec4 4096, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "PC loads next_pc on first posedge clk after reset release";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %pushi/vec4 4100, 0, 32;
    %store/vec4 v0x59ebe3fef180_0, 0, 32;
    %wait E_0x59ebe3fa5640;
    %delay 1000, 0;
    %pushi/vec4 4100, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "PC loads next_pc on subsequent posedge clk";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %pushi/vec4 4104, 0, 32;
    %store/vec4 v0x59ebe3fef180_0, 0, 32;
    %wait E_0x59ebe3fa5640;
    %delay 1000, 0;
    %pushi/vec4 4104, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "PC continues tracking next_pc each cycle";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %pushi/vec4 4294967295, 0, 32;
    %store/vec4 v0x59ebe3fef180_0, 0, 32;
    %wait E_0x59ebe3f91f20;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59ebe3fef290_0, 0, 1;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "mid-cycle async reset forces PC=0 without waiting for posedge clk";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59ebe3fef290_0, 0, 1;
    %pushi/vec4 8192, 0, 32;
    %store/vec4 v0x59ebe3fef180_0, 0, 32;
    %wait E_0x59ebe3fa5640;
    %delay 1000, 0;
    %pushi/vec4 8192, 0, 32;
    %store/vec4 v0x59ebe3fbc200_0, 0, 32;
    %pushi/str "PC resumes loading next_pc after reset released again";
    %store/str v0x59ebe3fbd370_0;
    %fork TD_tb_pc_reg.check, S_0x59ebe3fcba90;
    %join;
    %vpi_call/w 3 84 "$display", "=== tb_pc_reg: %0d checks, %0d errors ===", v0x59ebe3feef80_0, v0x59ebe3fef0e0_0 {0 0 0};
    %load/vec4 v0x59ebe3fef0e0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_4.0, 4;
    %vpi_call/w 3 85 "$display", "*** TB_PC_REG: ALL TESTS PASSED ***" {0 0 0};
    %jmp T_4.1;
T_4.0 ;
    %vpi_call/w 3 86 "$display", "*** TB_PC_REG: %0d TEST(S) FAILED ***", v0x59ebe3fef0e0_0 {0 0 0};
T_4.1 ;
    %vpi_call/w 3 87 "$finish" {0 0 0};
    %end;
    .thread T_4;
